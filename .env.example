USE_REAL_LLM=true
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_API_KEY=
# Shared process limit: 1–50; default 10 with shared 250 ms start pacing. Per-submission fanout stays <=20.
OPENROUTER_CONCURRENCY=10
ALLOW_LOCAL_FALLBACK=false

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_SECRET=
PARTICIPANT_SESSION_SECRET=
KEEPALIVE_SECRET=

# Optional seed-time overrides.
EVENT_PHASE=not_started
LEADERBOARD_VISIBILITY=practice
