# Server-only development configuration. Never commit actual credentials.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=prompt_off
PGUSER=prompt_off_app
PGPASSWORD_FILE=
# DATABASE_URL is an alternative; do not configure conflicting sources.
PGPOOL_MAX=10

# Set one source per independent secret, each at least 32 bytes.
ADMIN_SECRET_FILE=
PARTICIPANT_SESSION_SECRET_FILE=
APP_ORIGIN=http://localhost:3000

USE_REAL_LLM=false
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_CONCURRENCY=10
ALLOW_LOCAL_FALLBACK=false

# Optional fresh synthetic seed settings; never auto-seed an existing event.
EVENT_PHASE=not_started
LEADERBOARD_VISIBILITY=practice
